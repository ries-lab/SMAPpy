# The extensions are compiled from the sdist, so everything the compiler reads
# has to be in it: setuptools ships the .cpp files it was told to build, but not
# the headers they include, and without these the sdist builds nowhere.
include csrc/*.hpp
include ci/*.py
include src/smappy/data/*.json
include src/smappy/data/*.gui.yaml
recursive-include src/smappy/data/icons *.svg *.png
recursive-include src/smappy/data/csv_conversions *.yaml
recursive-include src/smappy/data/segment_presets *.yaml
recursive-include src/smappy/plugins/docs *.md
recursive-include src/smappy/docs/panels *.md
recursive-include tests *.py
include THIRD_PARTY_NOTICES.md
include src/smappy/_comet/LICENSE.txt
